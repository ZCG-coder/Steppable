{
    "folders":
    [
        {
            "path": ".",
        },
    ],
    "debugger_configurations":
    [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Test run parser",
            "program": "${folder}/build/parser/stp_parse",
            "args": ["${folder}/parser/tests/stp_files/test1.stp"],
            "cwd": "${folder}",
            "pre_debug_task": "CMake Build"
        },
    ],
    "debugger_tasks":
    [
        {
            "name": "CMake Build",
            "cmd": ["ninja", "stp_parse"],
            "working_dir": "$project_path/build",
        },
        {
            "name": "Ninja Clean",
            "cmd": ["ninja", "clean"],
            "working_dir": "$project_path/build",
        },
        {
            "name": "Format everything",
            "shell_cmd": "find . -name '*.hpp' -o -name '*.cpp' | xargs clang-format -i",
            "working_dir": "$project_path",
        }
    ],
    "settings": {
        "SublimeLinter.linters.clangtidy.compile_commands": "${project_path}/build",
    },
}
